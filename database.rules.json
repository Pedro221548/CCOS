
{
  "rules": {
    ".read": "auth != null",
    ".write": false, 

    "users": {
      ".read": "auth != null",
      "$uid": {
         ".write": "root.child('users').child(auth.uid).child('role').val() === 'admin' || auth.uid === $uid",
         ".validate": "newData.hasChildren(['email', 'role'])"
      }
    },

    "messages": {
      ".read": "auth != null",
      ".write": "auth != null",
      ".indexOn": ["senderId", "status", "timestamp"]
    },

    "private_messages": {
      ".read": "auth != null",
      ".write": "auth != null",
      "$chatId": {
        ".indexOn": ["status", "timestamp", "senderId"]
      }
    },

    "tasks": {
      ".read": "auth != null",
      ".write": "auth != null",
      ".indexOn": ["assignedToId", "status", "createdAt"]
    },

    "notifications": {
      ".read": "auth != null",
      ".write": "auth != null",
      "$uid": {
        ".indexOn": ["timestamp"]
      }
    },

    "email_pendencies": {
      ".read": "auth != null",
      ".write": "auth != null"
    },

    "monitoramento": {
      ".read": "auth != null",
      ".write": "auth != null",
      "feedbacks": {
        ".indexOn": ["timestamp", "userId"]
      },
      "service_workers": {
        ".indexOn": ["companyId", "cpf", "companyName"]
      },
      "attendance_roster": {
        ".indexOn": ["date", "workerId", "companyName"]
      }
    }
  }
}
